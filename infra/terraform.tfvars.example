project_id       = "pawacloud-assessment"
region           = "africa-south1"
google_client_id = "xxx.apps.googleusercontent.com" # public identifier, not a secret

# Secrets are NOT set here any more. gemini_api_key, redis_url,
# google_client_secret, session_secret and database_url live in Secret Manager
# and are read by secrets.tf. Create/rotate them with gcloud, e.g.:
#
#   printf '%s' 'VALUE' | gcloud secrets create gemini-api-key \
#     --project=pawacloud-assessment --replication-policy=automatic --data-file=-
#   printf '%s' 'NEW_VALUE' | gcloud secrets versions add gemini-api-key \
#     --project=pawacloud-assessment --data-file=-
#
# The variables still exist (see variables.tf) but are unwired; setting them
# here has no effect on the deployed service.
